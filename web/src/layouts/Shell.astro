---
// Page frame: brand lockup, sections, search and theme switch on top; bottom tab bar on phones; tagline footer.
import '../styles/global.css';
import Mark from '../components/Mark.astro';

interface Props { title: string; active: 'home' | 'pick' | 'books' | 'fill' | 'health' | 'movie'; searchAction?: string; searchPlaceholder?: string }
const { title, active, searchAction = '/', searchPlaceholder = '在森林里找一部片、一本书…' } = Astro.props;
const nav = [
  ['home', '/', '片库'], ['books', '/books', '书架'], ['pick', '/pick', '选片'], ['fill', '/fill', '补片'], ['health', '/health', '体检'],
] as const;
const tabs = [
  ['home', '/', '片库', 'M4 5h16v14H4zM9 5v14M4 10h5M4 15h5'],
  ['books', '/books', '书架', 'M2 4h7a3 3 0 0 1 3 3v13a2 2 0 0 0-2-2H2zM22 4h-7a3 3 0 0 0-3 3v13a2 2 0 0 1 2-2h8z'],
  ['pick', '/pick', '选片', 'M4 6h16M7 12h10M10 18h4'],
  ['fill', '/fill', '补片', 'M12 21V11M12 11c0-4 3-7 8-7 0 5-3 7-8 7zM12 13c0-3-2.5-5-6-5 0 3.5 2.5 5 6 5z'],
  ['health', '/health', '体检', 'M3 12h4l3-7 4 14 3-7h4'],
] as const;
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#2F4A3A">
  <meta name="description" content="Mori 森记 · Your Personal Digital Garden">
  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <title>{title}</title>
  <script is:inline>
    (() => {
      const mq = matchMedia('(prefers-color-scheme: dark)');
      const saved = () => { try { return localStorage.getItem('theme'); } catch { return null; } };
      const apply = () => { document.documentElement.dataset.theme = saved() || (mq.matches ? 'dark' : 'light'); };
      apply();
      mq.addEventListener('change', apply);
      window.__applyTheme = apply;
    })();
  </script>
</head>
<body class="flex min-h-dvh flex-col pb-[calc(64px+env(safe-area-inset-bottom))] md:pb-0">
  <header class="sticky top-0 z-30 border-b border-rule bg-ink/90 backdrop-blur-md">
    <div class="mx-auto flex max-w-[1440px] flex-wrap items-center gap-x-6 gap-y-3 px-4 py-3 md:px-8 md:py-3.5">
      <a href="/" aria-label="Mori 森记 首页" class="flex items-center gap-2 whitespace-nowrap no-underline">
        <Mark class="h-8 w-8" />
        <span class="font-brand text-[22px] font-medium leading-none tracking-[-0.01em] text-[#1F2A22] dark:text-text">mori</span>
        <span class="text-[15px] font-medium leading-none text-[#3E4A42] dark:text-soft">森记</span>
      </a>
      <nav aria-label="页面" class="hidden gap-1 md:flex">
        {nav.map(([key, href, label]) => (
          <a href={href} aria-current={active === key ? 'page' : undefined}
            class:list={['rounded-xl px-3.5 py-2 text-sm no-underline transition-colors', active === key ? 'bg-accent-bg font-medium text-accent-hi' : 'text-muted hover:bg-raise hover:text-text']}>{label}</a>
        ))}
      </nav>
      <div class="ml-auto flex items-center gap-2 md:order-last md:ml-0">
        <button id="theme-btn" type="button" class="inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-xl border border-line bg-panel text-muted transition-colors hover:border-edge-3 hover:text-text" aria-label="切换深浅色">
          <svg class="theme-sun" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
          <svg class="theme-moon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path></svg>
        </button>
      </div>
      <form action={searchAction} method="get" role="search" class="order-last flex min-h-11 w-full flex-1 basis-full items-center gap-2.5 rounded-xl border border-line bg-panel px-3.5 transition-colors focus-within:border-accent md:order-none md:basis-80">
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="shrink-0 text-muted"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
        <input id="site-q" name="q" type="search" enterkeyhint="search" autocomplete="off" aria-label="搜索" placeholder={searchPlaceholder}
          class="min-w-0 flex-1 bg-transparent text-text outline-none placeholder:text-muted" />
      </form>
    </div>
  </header>
  <div class="flex-1"><slot /></div>
  <footer class="mx-auto flex w-full max-w-[1440px] items-center gap-2 px-4 pb-6 pt-2 text-xs text-muted md:px-8">
    <Mark class="h-4 w-4 opacity-80" />
    <span class="font-brand tracking-[0.08em]">Collect · Connect · Grow</span>
  </footer>
  <nav aria-label="主导航" class="fixed inset-x-0 bottom-0 z-30 grid grid-cols-5 border-t border-rule bg-nav/95 pb-[env(safe-area-inset-bottom)] backdrop-blur-md md:hidden">
    {tabs.map(([key, href, label, d]) => (
      <a href={href} aria-current={active === key ? 'page' : undefined}
        class:list={['flex min-h-[52px] flex-col items-center justify-center gap-0.5 text-[11px] no-underline', active === key ? 'font-medium text-accent-hi' : 'text-muted hover:text-text']}>
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={d}></path></svg>
        {label}
      </a>
    ))}
  </nav>
  <style is:global>
    [data-theme="dark"] .theme-moon, :root:not([data-theme="dark"]) .theme-sun { display: none; }
  </style>
  <script is:inline>
    const q = new URLSearchParams(location.search).get('q');
    if (q) document.getElementById('site-q').value = q;
    const btn = document.getElementById('theme-btn');
    const label = () => btn.setAttribute('aria-label', document.documentElement.dataset.theme === 'dark' ? '切换到浅色' : '切换到深色');
    label();
    btn.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      const system = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      try { next === system ? localStorage.removeItem('theme') : localStorage.setItem('theme', next); } catch {}
      document.documentElement.dataset.theme = next;
      label();
    });
  </script>
</body>
</html>
